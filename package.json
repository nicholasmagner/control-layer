{
  "name": "controllayer",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:sample": "SEED_SAMPLE_DATA=true prisma db seed",
    "scan": "tsx scripts/scan.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
