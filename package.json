    "@aws-sdk/client-cloudtrail": "^3.1163.0",
    "@aws-sdk/client-ec2": "^3.1015.0",
    "@aws-sdk/client-iam": "^3.1015.0",
    "@aws-sdk/client-rds": "^3.1163.0",
    "@aws-sdk/client-s3": "^3.1163.0",
    "@azure/identity": "^4.14.1",
    "@prisma/client": "^5.22.0",
    "asn1js": "^4.0.0",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.3.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.577.0",
    "next": "^16.3.5",
    "pkijs": "^4.0.1",
    "prisma": "^5.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
