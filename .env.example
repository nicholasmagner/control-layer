# Copy to .env and fill in what you need. Only DATABASE_URL is required.

# --- Database -----------------------------------------------------------------
# Matches the database in docker-compose.yml (exposed on port 5433).
# Inside Docker Compose the app sets this itself.
DATABASE_URL="postgresql://controllayer:changeme@localhost:5433/controllayer"

# --- Workspace ----------------------------------------------------------------
# Shown in the app and on audit evidence packages.
ORGANIZATION_NAME="Acme Inc"
# Scan every configured cloud account on a schedule (hours). Leave empty to
# scan only on demand or from cron with `npm run scan`.
SCAN_INTERVAL_HOURS=

# --- Amazon Web Services (read-only) ---------------------------------------------
# Any standard AWS credential source works: these variables, AWS_PROFILE, SSO,
# or an IAM role attached to the server. Grant the managed policy SecurityAudit.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGIONS=us-east-1

# --- Google Cloud (read-only) ---------------------------------------------------
# Service account with roles Viewer + Security Reviewer on the project.
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Microsoft Azure (read-only) ------------------------------------------------
# Service principal with Reader + Security Reader on the subscription.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- Optional features ----------------------------------------------------------
# Lets admins apply a "require MFA" IAM policy to AWS users from a finding.
# This is the only feature that changes a cloud account; it needs
# iam:PutUserPolicy in addition to SecurityAudit.
ENABLE_AWS_REMEDIATION=false

# Optional assistant that explains controls and drafts audit narrative.
# Disabled when empty. Takes an Anthropic API key; ASSISTANT_MODEL is optional.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# Session cookies are HTTPS-only automatically when a proxy sends
# X-Forwarded-Proto: https. Set true to always require HTTPS.
SECURE_COOKIES=false
