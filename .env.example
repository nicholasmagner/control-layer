# Copy to .env and fill in what you need. Only DATABASE_URL is required.
# Most settings can instead be changed in the app (Settings), which wins over
# the values here.

# --- Database -----------------------------------------------------------------
# Matches the database in docker-compose.yml (exposed on port 5433).
# Inside Docker Compose the app sets this itself.
DATABASE_URL="postgresql://controllayer:changeme@localhost:5433/controllayer"

# --- Workspace ----------------------------------------------------------------
# Shown in the app and on audit evidence packages.
ORGANIZATION_NAME="Acme Inc"
# Scan every configured cloud account on a schedule (hours). Leave empty to
# scan only on demand or from cron with `npm run scan`.
SCAN_INTERVAL_HOURS=
# Every scan saves the raw results. An evidence image (PNG) is also made the
# first time, whenever a check's pass/fail result changes, and at least this
# often (days) while nothing changes, giving auditors a dated series.
SNAPSHOT_INTERVAL_DAYS=30
# RFC 3161 Time-Stamp Authority used to independently timestamp the evidence
# chain. Only a SHA-256 digest is sent. Set to "off" to disable.
TIMESTAMP_AUTHORITY_URL=https://freetsa.org/tsr

# --- Cloud accounts ------------------------------------------------------------
# Connect clouds in the app: Cloud Accounts > Connect (browser sign-in or a
# read-only key). Keys saved there are encrypted with this value. Generate one:
#   openssl rand -base64 32
# Keep it safe: if it changes, saved keys must be entered again.
CONTROLLAYER_SECRET_KEY=

# Advanced: instead of connecting in the app, a server can use environment
# variables (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGIONS,
# GCP_PROJECT_ID + GOOGLE_APPLICATION_CREDENTIALS, AZURE_SUBSCRIPTION_ID +
# AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET).

# --- Optional features ----------------------------------------------------------
# Lets admins apply a "require MFA" IAM policy to AWS users from a finding.
# This is the only feature that changes a cloud account; it needs
# iam:PutUserPolicy in addition to SecurityAudit.
ENABLE_AWS_REMEDIATION=false

# Optional assistant that explains controls and drafts audit narrative.
# Disabled when empty. Takes an Anthropic API key; ASSISTANT_MODEL is optional.
ASSISTANT_API_KEY=
ASSISTANT_MODEL=

# Session cookies are HTTPS-only automatically when a proxy sends
# X-Forwarded-Proto: https. Set true to always require HTTPS.
SECURE_COOKIES=false
