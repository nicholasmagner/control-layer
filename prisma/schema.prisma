generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// People
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  // 'admin' | 'member' | 'auditor'
  role         String    @default("member")
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  sessions Session[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Frameworks and controls
// The control catalog lives in src/frameworks and is synced into this table.
// ---------------------------------------------------------------------------

model Control {
  id          String   @id @default(uuid())
  framework   String
  controlId   String
  name        String
  description String
  category    String   @default("")
  applicable  Boolean  @default(true)
  naReason    String?
  owner       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scores   AssessmentScore[]
  evidence EvidenceControl[]

  @@unique([framework, controlId])
}

model AssessmentScore {
  id            String   @id @default(uuid())
  controlId     String
  // 'Met' | 'Partially Met' | 'Not Met' | 'Needs Evidence' | 'Not Applicable'
  status        String
  justification String?
  evaluatedAt   DateTime @default(now())

  control Control @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@index([controlId, evaluatedAt])
}

// ---------------------------------------------------------------------------
// Scans
// ---------------------------------------------------------------------------

model CheckRun {
  id         String    @id @default(uuid())
  // 'aws' | 'gcp' | 'azure'
  provider   String
  // 'running' | 'success' | 'partial' | 'error'
  status     String    @default("running")
  error      String?
  isSample   Boolean   @default(false)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  results CheckResult[]

  @@index([provider, startedAt])
}

model CheckResult {
  id           String   @id @default(uuid())
  runId        String
  checkId      String
  provider     String
  resourceId   String
  resourceName String?
  // 'pass' | 'fail'
  status       String
  message      String
  details      Json?
  createdAt    DateTime @default(now())

  run CheckRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([checkId])
}

model Finding {
  id          String    @id @default(uuid())
  title       String
  description String
  // 'High' | 'Medium' | 'Low'
  severity    String
  resource    String?
  remediation String?   @db.Text
  details     Json?
  // 'Open' | 'Resolved' | 'Accepted'
  status      String    @default("Open")
  checkId     String?
  provider    String?
  isSample    Boolean   @default(false)
  acceptedBy  String?
  acceptReason String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([checkId, resource, status])
}

// ---------------------------------------------------------------------------
// Evidence
// Every non-sample artifact is appended to a SHA-256 hash chain (seq order) so
// any later edit, deletion or reordering is detectable.
// ---------------------------------------------------------------------------

model EvidenceArtifact {
  id          String    @id @default(uuid())
  seq         Int       @unique @default(autoincrement())
  title       String
  description String?
  // 'automated' | 'upload' | 'note'
  kind        String    @default("automated")
  source      String
  content     Json?
  fileName    String?
  mimeType    String?
  fileSize    Int?
  fileData    Bytes?
  sha256      String?
  prevHash    String?
  chainHash   String?
  isSample    Boolean   @default(false)
  collectedBy String?
  collectedAt DateTime  @default(now())

  controls EvidenceControl[]

  @@index([collectedAt])
}

model EvidenceControl {
  evidenceId String
  controlId  String

  evidence EvidenceArtifact @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  control  Control          @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@id([evidenceId, controlId])
  @@index([controlId])
}

// ---------------------------------------------------------------------------
// Activity log: who did what, when.
// ---------------------------------------------------------------------------

model EventLog {
  id        String   @id @default(uuid())
  action    String
  actor     String
  resource  String?
  decision  String
  reason    String?
  timestamp DateTime @default(now())
  metadata  Json?

  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// Independent timestamps (RFC 3161) of the evidence chain head. Each token
// proves every evidence record up to `seq` existed by `genTime`.
// ---------------------------------------------------------------------------

model ChainAnchor {
  id        String   @id @default(uuid())
  seq       Int
  chainHash String
  tsaUrl    String
  token     Bytes
  genTime   DateTime
  createdAt DateTime @default(now())

  @@index([seq])
}

// ---------------------------------------------------------------------------
// Cloud account connections made in the app (Cloud Accounts > Connect).
// Keys are encrypted with CONTROLLAYER_SECRET_KEY; environment variables
// still work as a fallback for server installs.
// ---------------------------------------------------------------------------

model ConnectorConfig {
  // 'aws' | 'gcp' | 'azure'
  provider    String   @id
  // 'signin' (browser sign-in through the cloud's CLI) | 'keys'
  method      String
  // Non-secret settings: regions, project, subscription, account label.
  settings    Json
  // AES-256-GCM encrypted JSON with keys, when method = 'keys'.
  secret      String?
  connectedBy String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Workspace settings edited in the app (Settings). Values are JSON strings;
// secret values (the assistant API key) are encrypted. Environment variables
// are only used when a setting has not been saved here.
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     String
  updatedBy String
  updatedAt DateTime @updatedAt
}
